{
  "kind": "collectionType",
  "collectionName": "subjects",
  "info": {
    "singularName": "subject",
    "pluralName": "subjects",
    "displayName": "Materia"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "code": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "credits": {
      "type": "integer",
      "min": 1,
      "required": true
    },
    "semester": {
      "type": "integer",
      "min": 1,
      "max": 10,
      "required": true
    },
    "career": {
      "type": "enumeration",
      "enum": ["all", "ICO", "ICI", "ISES", "IME", "IEE", "IA"],
      "default": "all",
      "required": true
    },
    "isElective": {
      "type": "boolean",
      "default": false,
      "required": true
    }
  }
}
