{
  "kind": "collectionType",
  "collectionName": "student_records",
  "info": {
    "singularName": "student-record",
    "pluralName": "student-records",
    "displayName": "Datos del estudiante"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "semester": {
      "type": "integer",
      "min": 1,
      "max": 999,
      "required": true
    },
    "semesterBatch": {
      "type": "string"
    },
    "average": {
      "type": "decimal",
      "min": 0,
      "max": 10,
      "required": true
    },
    "academicStatus": {
      "type": "enumeration",
      "enum": ["regular", "irregular"],
      "required": true
    },
    "address": {
      "type": "text"
    },
    "contactPhone": {
      "type": "string"
    },
    "contactEmail": {
      "type": "email"
    },
    "parentNames": {
      "type": "string"
    },
    "bloodType": {
      "type": "string"
    },
    "postalCode": {
      "type": "string"
    },
    "fullName": {
      "type": "string"
    },
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "career": {
      "type": "enumeration",
      "enum": ["ICO", "ICI", "ISES", "IME", "IEE", "IA"]
    },
    "accountNumber": {
      "type": "string",
      "minLength": 7,
      "maxLength": 7,
      "unique": true
    },
    "enrollmentEnabled": {
      "type": "boolean",
      "default": false
    },
    "withdrawalEligible": {
      "type": "boolean",
      "default": false
    },
    "withdrawn": {
      "type": "boolean",
      "default": false
    },
    "passwordResetRequested": {
      "type": "boolean",
      "default": false
    }
  }
}
